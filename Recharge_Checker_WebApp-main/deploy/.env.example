# Copy this to /opt/dishhome_webapp/.env on the VPS and fill in real values.
# The systemd service (deploy/gunicorn.service) loads this file.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=report.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://report.yourdomain.com

DB_NAME=dishhome_reports
DB_USER=dishhome_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
