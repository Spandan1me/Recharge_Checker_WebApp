[Unit]
Description=Gunicorn daemon for DishHome Analytics (Django)
After=network.target

[Service]
# Adjust these paths to wherever you deploy the project on the VPS
User=www-data
Group=www-data
WorkingDirectory=/opt/dishhome_webapp
EnvironmentFile=/opt/dishhome_webapp/.env
ExecStart=/opt/dishhome_webapp/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/opt/dishhome_webapp/gunicorn.sock \
    dishhome_webapp.wsgi:application

Restart=on-failure

[Install]
WantedBy=multi-user.target
